{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Leica-Shen/deepseek-harness-metre/schema/deck.schema.json",
  "title": "Metre deck content",
  "type": "object",
  "required": ["pages"],
  "additionalProperties": true,
  "properties": {
    "language": {"enum": ["sweet", "iron", "paper", "grid", "manifesto"]},
    "variation": {"oneOf": [{"type": "integer"}, {"type": "string"}, {"const": "auto"}]},
    "fonts": {"oneOf": [
      {"const": "auto"},
      {"type": "object", "properties": {
        "ea_display": {"type": "string"}, "ea_body": {"type": "string"},
        "ea_micro": {"type": "string"}, "display": {"type": "string"},
        "body_font": {"type": "string"}, "micro_font": {"type": "string"}}}
    ]},
    "style": {"type": "object", "description": "见 spec --json 的 style_fields"},
    "color_mode": {"enum": ["language", "image"]},
    "accent_from_image": {"type": "boolean"},
    "assets": {"oneOf": [
      {"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "palette_from": {"type": "string"},
    "pages": {"type": "array", "minItems": 1, "maxItems": 60,
      "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "kind": {"enum": ["cover", "section", "statement", "points", "metrics", "band",
                          "cards", "split", "imagepanel", "compare", "table", "chart",
                          "gallery", "quote", "closing"]},
        "title": {"type": "string", "maxLength": 60},
        "kicker": {"type": "string", "maxLength": 24},
        "lead": {"type": "string"},
        "sub": {"type": "string"},
        "note": {"type": "string"},
        "tone": {"enum": ["light", "dark", "tint", "sand"]},
        "layout": {"enum": ["side-r", "side-l", "stack", "full", "inset"]},
        "media_side": {"enum": ["r", "l"]},
        "media_frac": {"enum": ["third", "half", "wide"]},
        "align": {"enum": ["left", "center", "right"]},
        "accent": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "panel": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "image": {"type": "string"},
        "fill_image": {"type": "string"},
        "items": {"type": "array", "maxItems": 5},
        "metrics": {"type": "array", "maxItems": 4,
          "items": {"type": "object", "required": ["v", "l"]}},
        "cards": {"type": "array", "maxItems": 4},
        "columns": {"type": "array", "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"type": "array"}},
        "values": {"type": "array", "items": {"type": "number"}},
        "statement": {"type": "string"},
        "quote": {"type": "string"},
        "by": {"type": "string"}
      }
    }
  }
}
